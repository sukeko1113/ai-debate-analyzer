{
  "$id": "https://github.com/sukeko1113/ai-debate-analyzer/schemas/ruleset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "const": "henda-20"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "maxIssuesPerSide": {
      "type": "number",
      "const": 2
    },
    "constructiveMaxWords": {
      "type": "number",
      "const": 600
    },
    "maxWordsPerMinute": {
      "type": "number",
      "const": 150
    },
    "graceSecAfterBell": {
      "type": "number",
      "const": 10
    },
    "communicationPoints": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "const": 1
        },
        "max": {
          "type": "number",
          "const": 5
        },
        "integerOnly": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "min",
        "max",
        "integerOnly"
      ]
    },
    "tieBreak": {
      "type": "string",
      "const": "NEG"
    },
    "stages": {
      "minItems": 12,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "type": {
            "type": "string",
            "enum": [
              "AFF_CONSTRUCTIVE",
              "NEG_QUESTIONS",
              "NEG_CONSTRUCTIVE",
              "AFF_QUESTIONS",
              "NEG_ATTACK",
              "AFF_ATTACK",
              "AFF_DEFENSE",
              "NEG_DEFENSE",
              "AFF_SUMMARY",
              "NEG_SUMMARY"
            ]
          },
          "side": {
            "type": "string",
            "enum": [
              "AFF",
              "NEG"
            ]
          },
          "durationSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "prepAfterSec": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "seat4": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "N1",
              "N2",
              "N3",
              "N4"
            ]
          },
          "seat3": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "N1",
              "N2",
              "N3",
              "N4"
            ]
          },
          "allowsNewIssue": {
            "type": "boolean"
          },
          "allowsAttack": {
            "type": "boolean"
          },
          "allowsDefense": {
            "type": "boolean"
          },
          "allowsComparison": {
            "type": "boolean"
          }
        },
        "required": [
          "no",
          "type",
          "side",
          "durationSec",
          "prepAfterSec",
          "seat4",
          "seat3",
          "allowsNewIssue",
          "allowsAttack",
          "allowsDefense",
          "allowsComparison"
        ]
      }
    },
    "chairCues": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "stage_start",
              "prep",
              "speech_start",
              "debate_end"
            ]
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "stageNo": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "pattern",
          "stageNo",
          "note"
        ]
      }
    },
    "evidenceRequirements": {
      "type": "object",
      "properties": {
        "factData": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expert": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "news": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "factData",
        "expert",
        "news"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "maxIssuesPerSide",
    "constructiveMaxWords",
    "maxWordsPerMinute",
    "graceSecAfterBell",
    "communicationPoints",
    "tieBreak",
    "stages",
    "chairCues",
    "evidenceRequirements"
  ]
}
