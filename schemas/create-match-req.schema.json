{
  "$id": "https://github.com/sukeko1113/ai-debate-analyzer/schemas/create-match-req.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "motion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "heldOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "round": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 20
        },
        {
          "type": "null"
        }
      ]
    },
    "affTeam": {
      "type": "string",
      "maxLength": 100
    },
    "negTeam": {
      "type": "string",
      "maxLength": 100
    },
    "rulesetId": {
      "type": "string",
      "const": "henda-20"
    },
    "rulesetVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "motion",
    "heldOn",
    "round",
    "affTeam",
    "negTeam",
    "rulesetId",
    "rulesetVersion"
  ]
}
