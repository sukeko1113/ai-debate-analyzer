{
  "$id": "https://github.com/sukeko1113/ai-debate-analyzer/schemas/env.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "DATABASE_URL": {
      "type": "string"
    },
    "DIRECT_URL": {
      "type": "string"
    },
    "NEXT_PUBLIC_SUPABASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "SUPABASE_JWT_SECRET": {
      "type": "string"
    },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "type": "string"
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "type": "string"
    },
    "TRANSCRIBE_A_PROVIDER": {
      "default": "stub",
      "type": "string"
    },
    "TRANSCRIBE_A_KEY": {
      "type": "string"
    },
    "TRANSCRIBE_B_PROVIDER": {
      "default": "stub",
      "type": "string"
    },
    "TRANSCRIBE_B_KEY": {
      "type": "string"
    },
    "ANALYSIS_MODEL": {
      "type": "string"
    },
    "ANALYSIS_KEY": {
      "type": "string"
    },
    "RULESET_DEFAULT": {
      "default": "henda-20",
      "type": "string"
    },
    "JOB_CRON_SECRET": {
      "type": "string"
    }
  },
  "required": [
    "DATABASE_URL"
  ]
}
