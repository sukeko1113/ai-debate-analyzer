{
  "$id": "https://github.com/sukeko1113/ai-debate-analyzer/schemas/put-members-req.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "teamSize": {
      "anyOf": [
        {
          "type": "number",
          "const": 3
        },
        {
          "type": "number",
          "const": 4
        }
      ]
    },
    "members": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "side": {
            "type": "string",
            "enum": [
              "AFF",
              "NEG"
            ]
          },
          "seat": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4",
              "N1",
              "N2",
              "N3",
              "N4"
            ]
          },
          "displayName": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "side",
          "seat",
          "displayName"
        ]
      }
    }
  },
  "required": [
    "expectedVersion",
    "teamSize",
    "members"
  ]
}
