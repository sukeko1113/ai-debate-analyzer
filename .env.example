# .env.example
#
# 置き場所の方針（docs/DEV_ENVIRONMENTS.md §3）:
#   - クラウド環境の設定にシークレットを1つも置かない
#     （専用のシークレットストアがなく、環境を使う人全員から読めるため）
#   - 実キーは GitHub Actions Secrets か、デスクトップの .env.local に置く
#   - クラウドセッションの DATABASE_URL は install_pkgs.sh が自動生成する

# ---------------------------------------------------------------------------
# DB（Data API は無効。supabase-js を DB アクセスに使わない）
# ---------------------------------------------------------------------------
# 本番: Supavisor transaction mode / 6543。postgres.js は prepare: false 必須
DATABASE_URL=postgres://app_server.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# マイグレーション専用: session mode / 5432。GitHub Actions Secrets にだけ置く
DIRECT_URL=postgres://app_migrator.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Supabase（Storage と Auth 専用。DB には使わない）
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT 検証鍵（HS256 / legacy JWT secret）。API のすべての経路がこれを要求する。
# 未設定だと 500 になる。認証を素通りさせる分岐は用意していない
SUPABASE_JWT_SECRET=

# TUS の直結ホスト（TRANSCRIPTION.md §7.3）。
# NEXT_PUBLIC_SUPABASE_URL から文字列操作で組み立てない。別の値として持つ
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://<project-ref>.storage.supabase.co
# メディアの保管先バケット（非公開・単一）
SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# 転写（P5・P8。デスクトップまたは CI でのみ設定する）
# ---------------------------------------------------------------------------
TRANSCRIBE_A_PROVIDER=stub
TRANSCRIBE_A_KEY=
TRANSCRIBE_B_PROVIDER=stub
TRANSCRIBE_B_KEY=

# ---------------------------------------------------------------------------
# 解析・判定支援
# ---------------------------------------------------------------------------
ANALYSIS_MODEL=
ANALYSIS_KEY=

# ---------------------------------------------------------------------------
# その他
# ---------------------------------------------------------------------------
RULESET_DEFAULT=henda-20
JOB_CRON_SECRET=
